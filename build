#!/usr/bin/env bash

set -euo pipefail

# Configuration
RUST_DIR="./rust"
LIB_NAME="rust"  # Cargo creates librust.so on Linux and rust.dll on Windows

# Default settings
BUILD_WIN=false
BUILD_MODE="release"

# CLI parsing
usage() {
    echo "Usage: $0 [-w|--windows] [-d|--debug] [-h|--help]"
    echo "  -w, --windows    Build for Windows (target/x86_64-pc-windows-gnu/)"
    echo "  -d, --debug      Build debug instead of release"
    echo "  -h, --help       Show help"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -w|--windows)
            BUILD_WIN=true
            shift
            ;;
        -d|--debug)
            BUILD_MODE="debug"
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done

# Ensure we're running from Godot root and rust dir exists
if [[ ! -d "$RUST_DIR" ]]; then
    echo "Error: Could not find directory '$RUST_DIR'. Make sure you run this script from your Godot root."
    exit 1
fi

CARGO_FLAGS=()
if [[ "$BUILD_MODE" == "release" ]]; then
    CARGO_FLAGS+=("--release")
fi

# Move into rust workspace/crate directory
cd "$RUST_DIR"

if [[ "$BUILD_WIN" == true ]]; then
    WIN_TARGET="x86_64-pc-windows-gnu"
    DEST_DIR="../bin/windows"

    echo "==> Building Windows DLL ($BUILD_MODE)..."

    # Auto-add rustup target if missing
    if ! rustup target list | grep -q "$WIN_TARGET (installed)"; then
        echo "Adding rustup target $WIN_TARGET..."
        rustup target add "$WIN_TARGET"
    fi

    cargo build --target "$WIN_TARGET" "${CARGO_FLAGS[@]}"

    SRC_FILE="target/$WIN_TARGET/$BUILD_MODE/${LIB_NAME}.dll"

    # Copy to ../bin/windows/rust.dll
    mkdir -p "$DEST_DIR"
    if [[ -f "$SRC_FILE" ]]; then
        cp "$SRC_FILE" "$DEST_DIR/${LIB_NAME}.dll"
        echo "Successfully copied: $SRC_FILE -> $DEST_DIR/${LIB_NAME}.dll"
    else
        echo "Error: Expected binary not found at $SRC_FILE"
        exit 1
    fi

else
    DEST_DIR="../bin/linux"

    echo "==> Building Linux shared library ($BUILD_MODE)..."
    cargo build "${CARGO_FLAGS[@]}"

    SRC_FILE="target/$BUILD_MODE/lib${LIB_NAME}.so"

    # Copy to ../bin/linux/librust.so
    mkdir -p "$DEST_DIR"
    if [[ -f "$SRC_FILE" ]]; then
        cp "$SRC_FILE" "$DEST_DIR/lib${LIB_NAME}.so"
        echo "Successfully copied: $SRC_FILE -> $DEST_DIR/lib${LIB_NAME}.so"
    else
        echo "Error: Expected binary not found at $SRC_FILE"
        exit 1
    fi
fi

echo "==> Build complete!"
